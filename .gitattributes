# Automatically detect text files
* text=auto

# Use LF line endings for source files
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Treat images as binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary

# Keep Git hooks using LF line endings
.githooks/* text eol=lf