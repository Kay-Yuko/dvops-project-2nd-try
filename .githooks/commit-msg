#!/bin/sh

commit_msg=$(cat "$1")

pattern='^(feat|fix|docs|style|refactor|test|chore)(\([a-z0-9-]+\))?: .+'

if ! printf '%s\n' "$commit_msg" | grep -Eq "$pattern"; then
    echo ""
    echo "ERROR: Invalid commit message!"
    echo ""
    echo "Please use the following format:"
    echo "type: description"
    echo ""
    echo "Examples:"
    echo "feat: add pet search filter"
    echo "fix: correct pet card layout"
    echo "docs: update project documentation"
    echo ""
    exit 1
fi

echo "Commit message format is valid!"
exit 0
